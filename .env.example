# --- Hindsight Cloud (https://ui.hindsight.vectorize.io -> API keys; promo code MEMHACK99 in Billing)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
BANK_ID=sprintmind_platform_team
# hindsight | local  (local = offline keyword store for UI work; not for the real demo)
MEMORY_BACKEND=hindsight
RETAIN_ASYNC=false
LEARN_FROM_INTERACTIONS=true

# --- Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Meeting recording / speech-to-text (free)
# groq  = Whisper large-v3-turbo on Groq's free tier (reuses GROQ_API_KEY, files up to 25 MB)
# local = faster-whisper on this machine, fully offline (pip install faster-whisper)
# none  = disable audio (pasted transcripts still work)
TRANSCRIBER=groq
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
LOCAL_WHISPER_MODEL=base
MEETINGS_DIR=data/meetings
KEEP_AUDIO=false

# --- Delivery ledger / GitHub (all optional; the demo works without GitHub credentials)
LEDGER_PATH=data/sprintmind.db
TICKET_PREFIXES=NW
# TICKET_URL_TEMPLATE=https://yourco.atlassian.net/browse/{ticket}
GITHUB_REPO=northwind/platform
# GITHUB_WEBHOOK_SECRET=<long random string, same as in the GitHub webhook settings>
TEAM_TIMEZONE=Asia/Kolkata

# --- Access control: demo (trusts the X-SprintMind-User header; not secure) | token
AUTH_MODE=demo
# API_TOKENS=neha=<random 32+ chars>,priya=<random 32+ chars>
LLM_MAX_TOKENS=3500

# --- Team context
TEAM_NAME=Northwind Platform Team
CURRENT_SPRINT=14
CORS_ORIGINS=*
